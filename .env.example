# --- entorno ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# El panel (5173) y la web publica (5174). La web publica lo necesita
# ademas para el portal del propietario: su comprobacion de origen lee
# esta misma lista. En produccion, los dominios reales de cada una.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- proxies ---
# Cuantos proxies hay delante de la API, o cuales. Sin esto `req.ip` es la del
# proxy para todo el mundo: el limite de peticiones se convierte en un cubo
# compartido por todos los visitantes y las IP que se guardan no sirven.
#
#   (vacio)          sin proxy delante — por defecto
#   1                un unico nginx / traefik delante
#   2                CDN + nginx
#   10.0.0.0/8,::1   solo esos origenes son de confianza
#
# NO admite "true": eso haria que Express se creyera el X-Forwarded-For de
# cualquiera, y saltarse el limite seria rotar una cabecera.
TRUST_PROXY=

# --- base de datos ---
# La BD todavia no existe: `docker compose up -d db` la crea con estos valores.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=serrano
DATABASE_PASSWORD=serrano
DATABASE_NAME=serrano
DATABASE_SSL=false
DATABASE_LOGGING=false

# --- autenticacion ---
# Genera secretos reales con: openssl rand -base64 48
JWT_ACCESS_SECRET=genera-uno-con-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=genera-otro-distinto-con-openssl-rand-base64-48
JWT_REFRESH_TTL=7d

# --- semilla del primer administrador (solo `yarn seed`) ---
SEED_ADMIN_EMAIL=contacto@serrano-inmobiliaria.com
SEED_ADMIN_PASSWORD=cambia-esta-clave

# Clave generica con la que se crean los asesores importados de WASI.
# Entran con ella una sola vez: la API les queda cerrada hasta que la cambien.
DEFAULT_USER_PASSWORD=cambia-esta-clave

# --- importador de WASI ---
WASI_DUMP_DIR=../data/wasi

# --- almacenamiento de imagenes ---
# Las fotos se descargan de WASI y se guardan aqui: el inventario deja de
# depender del CDN del proveedor.
UPLOADS_DIR=./uploads
UPLOAD_MAX_MB=15

# --- formularios publicos ---
# Sin CAPTCHA_SECRET la verificacion se salta y la API lo avisa por log.
CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET=
PUBLIC_BOOKING_LEAD_HOURS=24

# Analisis antivirus de lo que se sube (requiere clamdscan instalado).
ANTIVIRUS_ENABLED=false

# Dominio publico: sitemap y URL canonicas.
# Donde deja el build del sitio publico su index.html: se sirve desde ahi, con
# la cabecera del inmueble inyectada, a las URL de ficha.
PUBLIC_SITE_DIST=/var/www/web-clientes-inmobiliaria.nordikhat.com/dist

PUBLIC_SITE_URL=https://web-clientes-inmobiliaria.nordikhat.com

# --- asistente conversacional de la web publica ---
# El chat de la web contesta sobre el inventario. El modelo NO conoce los datos:
# solo puede pedirlos a las herramientas que golpean esta API, asi que nada de
# lo que afirma sale de su imaginacion.
#
# La clave vive SOLO aqui, en el servidor: el navegador nunca la ve. Sin clave,
# el asistente se apaga y su endpoint devuelve 503; el resto del sitio sigue.
CHAT_ENABLED=true
CHAT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# gpt-4.1-mini es el punto dulce coste/latencia; gpt-5.4-mini si se quiere mas.
CHAT_MODEL=gpt-4.1-mini
CHAT_BASE_URL=https://api.openai.com/v1
# El hilo es efimero (no se guarda): estos topes acotan lo que entra al modelo.
CHAT_MAX_MESSAGES=40
CHAT_MAX_CHARS=4000
CHAT_MAX_STEPS=6
